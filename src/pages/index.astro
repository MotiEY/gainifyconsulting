---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import SevenBricks from '../components/SevenBricks.astro';
import AnchorQuote from '../components/AnchorQuote.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Testimonials from '../components/Testimonials.astro';
import About from '../components/About.astro';
import Fit from '../components/Fit.astro';
import AIBlock from '../components/AIBlock.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { SITE } from '../config';

const SITE_URL = 'https://motisadot.com';
const pageTitle = 'מוטי שדות | ייעוץ עסקי אסטרטגי';
const pageDescription = 'מוטי שדות, ייעוץ עסקי אסטרטגי בגישת 7BRICKS. מיפוי, פיצוח ותכנית עבודה מעשית לבעלי עסקים והנהלות.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE.name,
      inLanguage: 'he-IL',
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE_URL}/#webpage`,
      url: `${SITE_URL}/`,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'he-IL',
      isPartOf: { '@id': `${SITE_URL}/#website` },
      about: { '@id': `${SITE_URL}/#business` },
      mainEntity: { '@id': `${SITE_URL}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: 'מוטי שדות',
      alternateName: 'Moti Sadot',
      jobTitle: 'יועץ עסקי אסטרטגי',
      description: 'מוטי שדות, יועץ עסקי אסטרטגי. מלווה בעלי עסקים ומייסדים בגישת 7BRICKS, על בסיס ניסיון של 26 שנה בניהול מערכות מורכבות.',
      image: {
        '@type': 'ImageObject',
        url: `${SITE_URL}/moti-sadot-hero-crop.jpg`,
        width: 700,
        height: 1250,
      },
      url: `${SITE_URL}/#about`,
      sameAs: [SITE.linkedin],
    },
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#business`,
      name: 'מוטי שדות – ייעוץ עסקי',
      url: `${SITE_URL}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${SITE_URL}/brand/logo-mark.png`,
        width: 1165,
        height: 284,
      },
      telephone: SITE.phone,
      founder: { '@id': `${SITE_URL}/#person` },
    },
  ],
};
---

<BaseLayout>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Hero />
  <ProofStrip />
  <SevenBricks />
  <AnchorQuote />
  <HowItWorks />
  <Testimonials />
  <About />
  <Fit />
  <AIBlock />
  <FAQ />
  <FinalCTA />
</BaseLayout>
