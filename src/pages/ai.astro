</div>
</div>
</BaseLayout>

<style>
.ai{
  --bg:var(--cream); --surface:var(--cream-2); --surface-2:var(--cream-4); --ink:var(--dark); --body:var(--dark);
  --tint:var(--bronze-l);
  --band:var(--darkest); --band-ink:var(--cream-dk); --band-mid:var(--mid-dk); --band-line:rgba(246,239,225,.14);
  --btn-bg:var(--dark); --btn-ink:var(--cream);
  --f-display:"Frank Ruhl Libre","David Libre",Georgia,serif; --f-body:"Assistant","Segoe UI",Arial,sans-serif;
  --max:1080px; --read:720px;
  font-size:17px;line-height:1.65;text-align:right
}
html.a11y-high-contrast .ai{--surface-2:#242424}
/* Layout: motisadot.com editorial system. Cream ground, serif display, bronze accents, one dark band for the "cost" and the formula. RTL, single reading column with wider grids for the method. */
.wrap{max-width:var(--max);margin-inline:auto;padding-inline:20px}
h1,h2,h3{font-family:var(--f-display);color:var(--ink);text-wrap:balance;margin:0;font-weight:900;line-height:1.15}
p{margin:0}
.kicker{font-size:12.5px;letter-spacing:.14em;color:var(--bronze);font-weight:600}
.en{direction:ltr;unicode-bidi:isolate}
a{color:inherit}
a:focus-visible{outline:2px solid var(--bronze);outline-offset:3px;border-radius:6px}

/* top bar */
.top{display:flex;justify-content:flex-start;align-items:center;padding-block:84px 18px;border-bottom:1px solid var(--line)}
.top .ai-tag{font-size:13px;color:var(--mid);border:1px solid var(--line-mid);border-radius:var(--r-btn);padding:4px 12px;text-decoration:none;transition:color .15s,border-color .15s}
.top .ai-tag:hover{color:var(--bronze);border-color:var(--bronze)}
#intent,#pulse{scroll-margin-top:84px}

/* hero */
.hero{display:grid;grid-template-columns:1.35fr 1fr;gap:48px;align-items:end;padding-block:64px 56px}
.hero > *{min-width:0}
.hero h1{font-size:clamp(36px,5.6vw,60px);margin-top:14px}
.hero h1 span{color:var(--bronze)}
.lead{font-size:19px;color:var(--mid);max-width:34em;margin-top:22px}
.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
.btn{display:inline-block;background:var(--btn-bg);color:var(--btn-ink);text-decoration:none;font-weight:700;padding:13px 24px;border-radius:var(--r-btn)}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line-mid)}
.reality{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-card);padding:26px}
.reality .label{font-size:13px;color:var(--faint);margin-bottom:12px}
.reality blockquote{margin:0;font-family:var(--f-display);font-size:24px;line-height:1.35;color:var(--ink);font-weight:700}
.reality ul{list-style:none;margin:20px 0 0;padding:0;display:grid;gap:10px}
.reality li{display:flex;gap:10px;font-size:15px;color:var(--mid)}
.reality li::before{content:"";flex:0 0 6px;height:6px;margin-top:10px;border-radius:50%;background:var(--gold)}

section{padding-block:64px;border-top:1px solid var(--line)}
.sec-head{max-width:var(--read);display:grid;gap:12px;margin-bottom:34px}
.sec-head h2{font-size:clamp(28px,3.6vw,40px)}
.sec-head p{color:var(--mid);font-size:17.5px}

/* dark band */
.band{background:var(--band);color:var(--band-ink);border-top:0}
.band h2,.band h3{color:var(--band-ink)}
.band .kicker{color:var(--gold)}
.band .sec-head p{color:var(--band-mid)}
.costs{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-top:1px solid var(--band-line)}
.cost{padding:22px 0 0 22px;border-left:1px solid var(--band-line)}
.cost:last-child{border-left:0}
.cost h3{font-size:20px;margin-bottom:8px}
.cost p{color:var(--band-mid);font-size:15px}

.formula{margin-top:56px;padding-top:48px;border-top:1px solid var(--band-line);display:grid;gap:22px}
.eq{display:flex;flex-wrap:wrap;align-items:baseline;gap:10px 18px;font-family:var(--f-display);font-weight:900;font-size:clamp(28px,4.2vw,46px);color:var(--band-ink);line-height:1.2}
.eq .x{color:var(--gold);font-weight:500}
.eq .lhs{color:var(--gold)}
.terms{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.terms div{border-top:2px solid var(--gold);padding-top:12px}
.terms b{display:block;font-size:17px}
.terms span{color:var(--band-mid);font-size:15px}
.punch{font-family:var(--f-display);font-size:22px;color:var(--band-ink)}
.punch em{font-style:normal;color:var(--gold)}

/* pulse */
.pulse{display:grid;grid-template-columns:1.25fr 1fr;gap:36px;align-items:start}
.pulse > *{min-width:0}
.domains{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.dom{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-card);padding:20px}
.dom .num{font-family:var(--f-display);font-size:28px;color:var(--gold);font-weight:900;line-height:1}
.dom h3{font-size:19px;margin-top:10px}
.dom .en{display:block;font-size:12px;color:var(--faint);letter-spacing:.04em;margin-top:2px}
.dom p{font-size:14.5px;color:var(--mid);margin-top:8px}

.map{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-card);padding:22px;position:sticky;top:calc(env(safe-area-inset-top,0px) + 16px)}
.map h3{font-size:20px}
.map .note{font-size:13px;color:var(--faint);margin-top:4px}
.rows{display:grid;gap:14px;margin-top:20px}
.row{display:grid;grid-template-columns:118px 1fr 30px;align-items:center;gap:10px;font-size:14px}
.row .lbl{color:var(--ink);font-weight:600}
.track{position:relative;height:10px;background:var(--surface-2);border-radius:99px}
.track .range{position:absolute;top:0;bottom:0;background:var(--tint);border:1px solid var(--line-mid);border-radius:99px}
.track .dot{position:absolute;top:50%;width:14px;height:14px;margin-top:-7px;margin-right:-7px;border-radius:50%;background:var(--bronze);border:2px solid var(--surface)}
.row .val{font-variant-numeric:tabular-nums;color:var(--mid);text-align:left}
.scale{display:grid;grid-template-columns:118px 1fr 30px;gap:10px;margin-top:6px;font-size:11.5px;color:var(--faint)}
.scale .ticks{display:flex;justify-content:space-between;font-variant-numeric:tabular-nums}
.legend{display:flex;flex-wrap:wrap;gap:16px;margin-top:16px;font-size:12.5px;color:var(--mid)}
.legend i{display:inline-block;vertical-align:middle;margin-left:6px}
.legend .d{width:11px;height:11px;border-radius:50%;background:var(--bronze)}
.legend .r{width:22px;height:9px;border-radius:99px;background:var(--tint);border:1px solid var(--line-mid)}
.insight{margin-top:18px;padding-top:16px;border-top:1px solid var(--line);font-size:14.5px;color:var(--body)}
.insight b{color:var(--ink)}

.outputs{margin-top:34px;display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid var(--line);border-radius:var(--r-card);overflow:hidden;background:var(--surface)}
.out{padding:18px 20px;border-left:1px solid var(--line);border-bottom:1px solid var(--line)}
.out:nth-child(3n){border-left:0}
.out:nth-last-child(-n+3){border-bottom:0}
.out b{display:block;color:var(--ink);font-size:16px}
.out span{font-size:14px;color:var(--mid)}

/* spectrum */
.spectrum{display:grid;grid-template-columns:repeat(5,1fr);gap:0;border-radius:var(--r-card);overflow:hidden;border:1px solid var(--line)}
.lvl{padding:20px 16px;background:var(--surface);border-left:1px solid var(--line);display:grid;gap:8px;align-content:start}
.lvl:last-child{border-left:0}
.lvl .bar{height:5px;border-radius:99px;background:var(--surface-2);overflow:hidden}
.lvl .bar i{display:block;height:100%;background:var(--bronze)}
.lvl h3{font-size:19px}
.lvl .en{font-size:12px;color:var(--faint)}
.lvl p{font-size:14px;color:var(--mid)}
.lvl .next{font-size:13.5px;color:var(--ink);border-top:1px solid var(--line);padding-top:8px;margin-top:4px}
.lvl .next b{color:var(--bronze);font-weight:700}

/* quick win */
.qw{display:grid;grid-template-columns:1fr 1.3fr;gap:40px;align-items:center}
.qw > *{min-width:0}
.qw-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.qw-card{border:1px solid var(--line);border-radius:var(--r-card);padding:18px;background:var(--surface)}
.qw-card b{display:block;color:var(--ink);font-size:17px}
.qw-card span{font-size:14px;color:var(--mid)}
.qw-card .pips{display:flex;gap:4px;margin-top:10px}
.qw-card .pips i{width:18px;height:6px;border-radius:99px;background:var(--bronze)}
.qw-card .pips i.o{background:var(--surface-2)}
.pull{font-family:var(--f-display);font-size:clamp(24px,2.8vw,30px);line-height:1.35;color:var(--ink);font-weight:700}
.pull + p{color:var(--mid);margin-top:14px}

/* phases */
.phases{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;counter-reset:ph}
.phase{border-top:3px solid var(--ink);padding-top:18px;display:grid;gap:10px;align-content:start}
.phase .when{font-size:13px;color:var(--bronze);font-weight:700;letter-spacing:.06em}
.phase h3{font-size:26px}
.phase h3 .en{font-family:var(--f-body);font-size:13px;color:var(--faint);font-weight:600;letter-spacing:.1em;display:block;margin-top:4px}
.phase ul{margin:0;padding:0;list-style:none;display:grid;gap:10px}
.phase li{font-size:15px;color:var(--body);padding-right:16px;position:relative}
.phase li::before{content:"";position:absolute;right:0;top:11px;width:7px;height:1px;background:var(--bronze)}
.phase li b{color:var(--ink)}

/* tracks table */
.tracks-wrap{overflow-x:auto;margin-top:44px;border:1px solid var(--line);border-radius:var(--r-card);background:var(--surface)}
table{width:100%;border-collapse:collapse;min-width:720px;font-size:14.5px}
th,td{text-align:right;padding:16px 18px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-size:12.5px;letter-spacing:.08em;color:var(--faint);font-weight:600;background:var(--surface-2)}
tr:last-child td{border-bottom:0}
td:first-child{font-family:var(--f-display);font-weight:700;font-size:17px;color:var(--ink);white-space:nowrap}
td .en{display:block;font-family:var(--f-body);font-size:11.5px;color:var(--faint);font-weight:500}

/* measures */
.measures{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:22px}
.measure{background:var(--tint);border-radius:var(--r-card);padding:20px}
.measure h3{font-size:18px;margin-bottom:10px}
.measure ul{margin:0;padding:0 18px 0 0;font-size:15px;color:var(--body);display:grid;gap:6px}

/* beliefs */
.beliefs{display:grid;gap:0}
.belief{display:grid;grid-template-columns:1fr 1fr;gap:28px;padding-block:20px;border-bottom:1px solid var(--line);align-items:baseline}
.belief:first-child{border-top:1px solid var(--line)}
.belief > *{min-width:0}
.belief h3{font-size:clamp(21px,2.4vw,26px);font-weight:700}
.belief p{color:var(--mid);font-size:15.5px}

/* me */
.me{display:grid;grid-template-columns:1fr 1fr;gap:40px}
.me > *{min-width:0}
.me p{color:var(--body);margin-bottom:14px}
.facts{display:grid;gap:0;border-top:1px solid var(--line)}
.fact{display:grid;grid-template-columns:110px 1fr;gap:16px;padding-block:14px;border-bottom:1px solid var(--line);align-items:baseline}
.fact b{font-family:var(--f-display);font-size:26px;color:var(--bronze);font-weight:900;font-variant-numeric:tabular-nums}
.fact span{font-size:15px;color:var(--mid)}

/* cta */
.cta{background:var(--band);color:var(--band-ink);border-radius:var(--r-card);padding:40px;display:grid;grid-template-columns:1.4fr 1fr;gap:28px;align-items:center}
.cta > *{min-width:0}
.cta h2{color:var(--band-ink);font-size:clamp(26px,3.2vw,36px)}
.cta p{color:var(--band-mid);margin-top:12px}
.cta .btn{background:var(--gold);color:#17130D}
.cta-btns{display:flex;flex-wrap:wrap;gap:12px}
.cta .btn.wa{background:transparent;color:var(--band-ink);border:1px solid rgba(246,239,225,.4)}
.cta .btn.wa:hover{border-color:var(--gold);color:var(--gold)}
.cta small{display:block;color:var(--band-mid);font-size:13.5px;margin-top:12px}

@media (max-width:900px){
  .hero,.pulse,.qw,.me,.cta{grid-template-columns:1fr}
  .map{position:static}
  .costs{grid-template-columns:1fr 1fr}
  .cost:nth-child(2){border-left:0}
  .cost{padding-bottom:22px}
  .spectrum{grid-template-columns:1fr}
  .lvl{border-left:0;border-bottom:1px solid var(--line)}
  .lvl:last-child{border-bottom:0}
  .phases{grid-template-columns:1fr}
  .outputs{grid-template-columns:1fr 1fr}
  .out{border-left:1px solid var(--line)!important;border-bottom:1px solid var(--line)!important}
  .out:nth-child(2n){border-left:0!important}
  .out:nth-last-child(-n+2){border-bottom:0!important}
}
@media (max-width:560px){
  .ai{font-size:16px}
  .hero{padding-block:40px}
  section{padding-block:48px}
  .domains,.qw-grid,.measures,.terms{grid-template-columns:1fr}
  .costs{grid-template-columns:1fr}
  .cost{border-left:0;padding-left:0;border-bottom:1px solid var(--band-line)}
  .cost:last-child{border-bottom:0}
  .outputs{grid-template-columns:1fr}
  .out{border-left:0!important;border-bottom:1px solid var(--line)!important}
  .out:last-child{border-bottom:0!important}
  .belief{grid-template-columns:1fr;gap:6px}
  .row,.scale{grid-template-columns:96px 1fr 26px}
  .cta{padding:28px 22px}
  .fact{grid-template-columns:84px 1fr}
}
@media (prefers-reduced-motion:no-preference){
  .btn{transition:transform .15s ease}
  .btn:hover{transform:translateY(-1px)}
}
</style>
