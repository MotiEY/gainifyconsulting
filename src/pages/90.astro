---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';

const SITE_URL = 'https://motisadot.com';
const phoneDigits = SITE.phone.replace('+', '');
const waMessage = 'היי מוטי, ראיתי את הדף על האבחון ואשמח לתאם שיחה קצרה';
const waUrl = `https://wa.me/${phoneDigits}?text=${encodeURIComponent(waMessage)}`;
const telUrl = `tel:${SITE.phone}`;
const phoneDisplay = '052-5523021';

const ogTitle = 'מה דחית ל"אחרי החגים"?';
const description = 'העסק גדל, יש לך צוות, ועדיין הכול עובר דרכך? מתחילים באבחון עסקי של כשעתיים, בלי עלות ובלי התחייבות.';
---

<BaseLayout
  title={`${ogTitle} | מוטי שדות`}
  ogTitle={ogTitle}
  description={description}
  canonicalUrl={`${SITE_URL}/90/`}
  ogImage={`${SITE_URL}/og/landing-90.jpg`}
  ogImageAlt={`${ogTitle} העסק גדל. יש לך צוות. ועדיין הכול עובר דרכך?`}
  noindex
  minimal
  phoneDisplay={phoneDisplay}
>
  <div class="lp">

    <section class="lp-open" aria-labelledby="lp-title">
      <p class="lp-kicker">מה דחית ל"אחרי החגים"?</p>
      <h1 class="lp-title" id="lp-title">
        <span>העסק גדל.</span>
        <span>יש לך צוות.</span>
        <span>ועדיין הכול עובר דרכך?</span>
      </h1>
      <p class="lp-sub">ליווי עסקי לבעלי עסקים שרוצים לצאת מהשוטף ולחזור לנהל את העסק.</p>
      <p class="lp-lead">מתחילים באבחון עסקי בלי עלות ובלי התחייבות</p>
      <a href={waUrl} class="lp-btn lp-btn-dark" target="_blank" rel="noopener noreferrer" data-ga-page="90">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.857L.054 23.454a.75.75 0 0 0 .918.918l5.633-1.476A11.942 11.942 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75a9.708 9.708 0 0 1-4.953-1.355l-.355-.211-3.683.965.981-3.595-.232-.371A9.718 9.718 0 0 1 2.25 12C2.25 6.615 6.615 2.25 12 2.25S21.75 6.615 21.75 12 17.385 21.75 12 21.75z"/></svg>
        שלח לי הודעה בוואטסאפ
      </a>
    </section>

    <section class="lp-how" aria-labelledby="lp-how-h">
      <h2 class="sr-only" id="lp-how-h">איך זה עובד</h2>

      <h3 class="lp-subhead">באבחון</h3>
      <ol class="lp-steps" role="list">
        <li>מבינים איפה העסק נמצא היום ולאן אתה רוצה להגיע</li>
        <li>מזהים במה נכון להתמקד כדי לקדם את העסק</li>
      </ol>

      <h3 class="lp-subhead">בליווי של 90 יום</h3>
      <ol class="lp-steps" role="list" start="3" style="counter-reset: step 2;">
        <li>מגדירים מטרות ומדדים ברורים</li>
        <li>עובדים יחד, מיישמים את השינויים ועוקבים אחרי ההתקדמות</li>
      </ol>
    </section>

    <section class="lp-proof" aria-labelledby="lp-proof-h">
      <div class="lp-proof-inner">
        <h2 class="sr-only" id="lp-proof-h">מהשטח</h2>
        <blockquote class="lp-quote">
          <p>"הגעתי למוטי כשהייתי עמוק בתוך הייצור רוב שעות היום... לא ראיתי איך מישהו יכול להחליף אותי במשבצת הכי מקצועית."</p>
        </blockquote>
        <blockquote class="lp-quote">
          <p>"מה שהכי עוזר לי בפגישות עם מוטי זה שהן גורמות לי לחשוב ממבט על ולא מראייה של השוטף."</p>
        </blockquote>
        <p class="lp-attr">דור, בעלים של מפעל ייצור בצמיחה</p>
        <p class="lp-changed"><strong>מה השתנה:</strong> כבר בחודשים הראשונים גייסנו עובד מקצועי למשבצת הקריטית ביותר בייצור. דור יצא מהייצור והיום מנהל את העסק. יכולת הייצור גדלה, ומשם עברנו לתמחור ולרווחיות.</p>
      </div>
    </section>

    <section class="lp-about" aria-labelledby="lp-about-h">
      <h2 class="sr-only" id="lp-about-h">מוטי שדות</h2>
      <img
        class="lp-photo"
        src="/moti-sadot-hero-crop.jpg"
        alt="מוטי שדות, יועץ עסקי אסטרטגי"
        width="700"
        height="1250"
        loading="lazy"
        decoding="async"
      />
      <p class="lp-about-text">26 שנה בניהול צוותים, מנהלים ומערכות מורכבות. יודע לקחת את הסדר של חברות גדולות לעסק צומח, בלי להעמיס עליו תהליכים שלא מתאימים לגודל שלו.</p>
    </section>

    <section class="lp-offer" aria-labelledby="lp-offer-h">
      <h2 class="lp-offer-title" id="lp-offer-h">אבחון עסקי של כשעתיים</h2>
      <p class="lp-offer-gold">בלי עלות ובלי התחייבות</p>
      <p class="lp-offer-text">אם יש התאמה, אפשר להמשיך לשלב ראשון של 90 יום.</p>
      <p class="lp-offer-text">עד 29.10 אני מקבל לליווי שלושה עסקים חדשים.</p>
      <a href={waUrl} class="lp-btn lp-btn-gold" target="_blank" rel="noopener noreferrer" data-ga-page="90">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.857L.054 23.454a.75.75 0 0 0 .918.918l5.633-1.476A11.942 11.942 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75a9.708 9.708 0 0 1-4.953-1.355l-.355-.211-3.683.965.981-3.595-.232-.371A9.718 9.718 0 0 1 2.25 12C2.25 6.615 6.615 2.25 12 2.25S21.75 6.615 21.75 12 17.385 21.75 12 21.75z"/></svg>
        שלח לי הודעה בוואטסאפ
      </a>
      <a href={telUrl} class="lp-btn lp-btn-ghost">התקשר {phoneDisplay}</a>
      <p class="lp-offer-small">ונקבע שיחה קצרה כדי לבדוק התאמה.</p>
    </section>

  </div>
</BaseLayout>

<style>
  .lp {
    max-width: 680px;
    margin: 0 auto;
    padding: 84px 24px 56px;
  }

  /* opening */
  .lp-kicker {
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 700;
    font-size: 25.5px;
    line-height: 1.3;
    color: #2F5D50;
    margin-bottom: 14px;
  }

  .lp-title {
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 700;
    font-size: clamp(28px, 8.2vw, 60px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-h);
    margin-bottom: 18px;
  }
  .lp-title span {
    display: block;
    white-space: nowrap;
  }

  .lp-sub {
    font-family: 'Assistant', sans-serif;
    font-size: 17px;
    line-height: 1.6;
    color: var(--mid);
    margin-bottom: 16px;
  }

  .lp-lead {
    font-family: 'Assistant', sans-serif;
    font-weight: 600;
    font-size: 17px;
    line-height: 1.5;
    color: var(--bronze);
    margin-bottom: 22px;
  }

  /* buttons */
  .lp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    font-family: 'Assistant', sans-serif;
    font-weight: 600;
    font-size: 16px;
    min-height: 52px;
    padding: 14px 30px;
    border-radius: var(--r-btn);
    text-decoration: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .lp-btn-dark {
    background: var(--dark);
    color: var(--cream-dk);
  }
  .lp-btn-dark:hover { background: var(--bronze); }

  .lp-btn-gold {
    background: var(--gold);
    color: var(--dark);
    font-size: 18px;
    min-height: 58px;
    width: 100%;
  }
  .lp-btn-gold:hover { background: var(--cream-dk); }

  .lp-btn-ghost {
    border: 1px solid rgba(246, 239, 225, 0.4);
    color: var(--cream-dk);
    width: 100%;
    margin-top: 12px;
  }
  .lp-btn-ghost:hover { border-color: var(--gold); color: var(--gold); }

  /* how it works */
  .lp-how {
    margin-top: 48px;
  }

  .lp-subhead {
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 700;
    font-size: 22px;
    line-height: 1.3;
    color: var(--text-h);
    margin-bottom: 14px;
  }

  .lp-steps {
    list-style: none;
    counter-reset: step;
    margin: 0 0 30px;
    padding: 0;
  }
  .lp-steps li {
    counter-increment: step;
    position: relative;
    padding-inline-start: 44px;
    margin-bottom: 14px;
    font-family: 'Assistant', sans-serif;
    font-size: 17px;
    line-height: 1.6;
    color: var(--mid);
  }
  .lp-steps li::before {
    content: counter(step);
    position: absolute;
    inset-inline-start: 0;
    top: 1px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--bronze);
    color: var(--bronze);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Assistant', sans-serif;
    font-weight: 600;
    font-size: 14px;
  }

  /* proof */
  .lp-proof {
    background: var(--cream-3);
    margin: 0 -24px;
    padding: 34px 24px;
  }
  .lp-proof-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .lp-quote {
    margin: 0 0 20px;
    padding-inline-start: 18px;
    border-inline-start: 3px solid var(--bronze);
  }
  .lp-quote p {
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-h);
  }

  .lp-attr {
    font-family: 'Assistant', sans-serif;
    font-weight: 600;
    font-size: 15px;
    color: var(--bronze);
    margin-bottom: 18px;
  }

  .lp-changed {
    font-family: 'Assistant', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: var(--mid);
  }
  .lp-changed strong {
    font-weight: 600;
    color: var(--text-h);
  }

  /* about */
  .lp-about {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px 24px;
    margin-top: 40px;
  }
  .lp-photo {
    width: 60%;
    max-width: 260px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top center;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .lp-about-text {
    width: 100%;
    font-family: 'Assistant', sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: var(--mid);
  }

  /* offer */
  .lp-offer {
    background: var(--dark);
    border-radius: var(--r-card);
    padding: 32px 24px;
    margin-top: 40px;
    color: var(--cream-dk);
  }
  .lp-offer-title {
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 700;
    font-size: 28px;
    line-height: 1.25;
    margin-bottom: 8px;
  }
  .lp-offer-gold {
    font-family: 'Assistant', sans-serif;
    font-weight: 600;
    font-size: 17px;
    color: var(--gold);
    margin-bottom: 14px;
  }
  .lp-offer-text {
    font-family: 'Assistant', sans-serif;
    font-size: 16px;
    line-height: 1.65;
    color: rgba(246, 239, 225, 0.88);
    margin-bottom: 8px;
  }
  .lp-offer .lp-btn-gold { margin-top: 18px; }
  .lp-offer-small {
    font-family: 'Assistant', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(246, 239, 225, 0.7);
    margin-top: 14px;
  }

  @media (min-width: 768px) {
    .lp { padding: 120px 40px 80px; }
    .lp-proof { margin: 0 -40px; padding: 44px 40px; }
    .lp-offer { padding: 40px 36px; }
    .lp-btn-gold, .lp-btn-ghost { width: auto; min-width: 280px; }
    .lp-offer .lp-btn-gold { margin-inline-end: 12px; }
    .lp-btn-ghost { margin-top: 18px; }
    .lp-about { flex-direction: row; align-items: center; }
    .lp-about-text { width: auto; flex: 1 1 240px; }
    .lp-photo { width: 150px; max-width: none; }
  }

  /* floating a11y button: 44px, tucked into the corner (no sticky bar on this page) */
  :global(body #a11y-trigger) { width: 44px; height: 44px; left: 12px; bottom: 12px; }
  :global(body #a11y-panel) { bottom: 64px; }
</style>
