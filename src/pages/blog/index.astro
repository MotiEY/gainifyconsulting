---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOPIC_LABELS, TOPIC_ORDER } from '../../data/blogTopics';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const [leadPost, ...restPosts] = posts;

function dateStr(date: Date) {
  return date.toLocaleDateString('he-IL', { year: 'numeric', month: 'long' });
}

function readingMinutes(body?: string) {
  const words = body
    ? body.replace(/[#>*_`\-\[\]()]/g, ' ').split(/\s+/).filter(Boolean).length
    : 0;
  return Math.max(1, Math.round(words / 180));
}

function slugOf(post: (typeof posts)[number]) {
  return post.data.slug ?? post.id;
}
---

<BaseLayout
  title="בלוג | מוטי שדות"
  description="מחשבות על ניהול, אסטרטגיה ועסקים מבעד לעדשה של 26 שנות ניסיון"
  canonicalUrl="https://motisadot.com/blog/"
>
  <section class="blog-page">
    <div class="page-inner">
      <header class="blog-intro">
        <h1 class="page-heading">בלוג</h1>
        <p class="intro-text">מחשבות ישרות על המקומות שבהם עסקים באמת נתקעים: ניהול, תהליכים, אנשים ופרויקטים. לא תאוריה, אלא כלים שאפשר להפעיל השבוע.</p>
      </header>

      {posts.length === 0 ? (
        <p class="empty-state">בקרוב יופיעו כאן מחשבות וכתבים</p>
      ) : (
        <>
          {leadPost && (
            <a href={`/blog/${slugOf(leadPost)}/`} class="lead-article">
              <div class="lead-meta">
                {leadPost.data.topics.length > 0 && (
                  <span class="lead-topic">
                    {leadPost.data.topics.map(t => TOPIC_LABELS[t]).filter(Boolean).join(' · ')}
                  </span>
                )}
                <time class="lead-date" datetime={leadPost.data.date.toISOString()}>
                  {dateStr(leadPost.data.date)}
                </time>
                <span class="lead-reading">כ-{readingMinutes(leadPost.body)} דקות קריאה</span>
              </div>
              <h2 class="lead-title">{leadPost.data.title}</h2>
              <p class="lead-desc">{leadPost.data.description}</p>
              <span class="lead-more">קרא את המאמר המלא ←</span>
            </a>
          )}

          {restPosts.length > 0 && (
            <>
              <div class="topic-filter" role="group" aria-label="סינון מאמרים לפי נושא">
                <button type="button" class="filter-btn active" data-filter="all" aria-pressed="true">הכול</button>
                {TOPIC_ORDER.map(topicKey => (
                  <button type="button" class="filter-btn" data-filter={topicKey} aria-pressed="false">
                    {TOPIC_LABELS[topicKey]}
                  </button>
                ))}
              </div>

              <div class="article-list">
                {restPosts.map(post => (
                  <a
                    href={`/blog/${slugOf(post)}/`}
                    class="article-row"
                    data-topics={post.data.topics.join(' ')}
                  >
                    <div class="row-meta">
                      {post.data.topics.length > 0 && (
                        <span class="row-topic">
                          {post.data.topics.map(t => TOPIC_LABELS[t]).filter(Boolean).join(' · ')}
                        </span>
                      )}
                      <time class="row-date" datetime={post.data.date.toISOString()}>
                        {dateStr(post.data.date)}
                      </time>
                    </div>
                    <h3 class="row-title">{post.data.title}</h3>
                    <p class="row-desc">{post.data.description}</p>
                  </a>
                ))}
              </div>
            </>
          )}
        </>
      )}
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const rows = document.querySelectorAll<HTMLAnchorElement>('.article-row');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');

        const filter = btn.dataset.filter;
        rows.forEach(row => {
          const topics = (row.dataset.topics || '').split(' ');
          const show = filter === 'all' || topics.includes(filter || '');
          row.hidden = !show;
        });
      });
    });
  </script>
</BaseLayout>

<style>
  /* mobile-first base */
  .blog-page {
    padding: 100px 24px 80px;
    min-height: calc(100vh - 60px);
  }

  .page-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .blog-intro {
    margin-bottom: 48px;
  }

  .page-heading {
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 300;
    font-size: clamp(36px, 6vw, 64px);
    color: var(--dark);
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .intro-text {
    font-family: 'Assistant', sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: var(--mid);
    max-width: 640px;
  }

  .empty-state {
    font-family: 'Assistant', sans-serif;
    font-size: 17px;
    color: var(--faint);
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  /* lead article */
  .lead-article {
    display: block;
    padding: 32px 0;
    border-top: 1px solid var(--line-mid);
    border-bottom: 1px solid var(--line-mid);
    margin-bottom: 12px;
    color: inherit;
  }

  .lead-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-bottom: 14px;
  }

  .lead-topic {
    font-family: 'Assistant', sans-serif;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--bronze);
  }

  .lead-date,
  .lead-reading {
    font-family: 'Assistant', sans-serif;
    font-size: 12px;
    letter-spacing: 0.05em;
    color: var(--faint);
  }

  .lead-title {
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 400;
    font-size: clamp(24px, 5vw, 38px);
    line-height: 1.25;
    color: var(--dark);
    letter-spacing: -0.015em;
    margin-bottom: 14px;
    max-width: 820px;
  }

  .lead-desc {
    font-family: 'Assistant', sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: var(--mid);
    max-width: 700px;
    margin-bottom: 18px;
  }

  .lead-more {
    font-family: 'Assistant', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--bronze);
    letter-spacing: 0.02em;
    transition: color 0.2s;
  }
  .lead-article:hover .lead-more { color: var(--dark); }

  /* topic filter */
  .topic-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
  }

  .filter-btn {
    font-family: 'Assistant', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--mid);
    background: none;
    border: 1px solid var(--line-mid);
    border-radius: var(--r-btn);
    padding: 9px 18px;
    min-height: 44px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .filter-btn:hover {
    border-color: var(--bronze);
    color: var(--dark);
  }
  .filter-btn.active {
    background: var(--dark);
    border-color: var(--dark);
    color: var(--cream-dk);
  }

  /* article list */
  .article-list {
    display: flex;
    flex-direction: column;
  }

  .article-row {
    display: block;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
  }
  .article-row:first-child { padding-top: 0; }

  .row-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-bottom: 8px;
  }

  .row-topic {
    font-family: 'Assistant', sans-serif;
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--bronze);
  }

  .row-date {
    font-family: 'Assistant', sans-serif;
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--faint);
  }

  .row-title {
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 400;
    font-size: clamp(19px, 3vw, 23px);
    line-height: 1.35;
    color: var(--dark);
    letter-spacing: -0.01em;
    margin-bottom: 8px;
    transition: color 0.2s;
  }
  .article-row:hover .row-title { color: var(--bronze); }

  .row-desc {
    font-family: 'Assistant', sans-serif;
    font-size: 15px;
    line-height: 1.65;
    color: var(--mid);
    max-width: 720px;
  }

  /* tablet */
  @media (min-width: 768px) {
    .blog-page { padding: 120px 40px 100px; }
    .lead-article { padding: 44px 0; margin-bottom: 32px; }
    .article-row { padding: 32px 0; }
  }

  /* desktop */
  @media (min-width: 1280px) {
    .blog-page { padding: 140px 52px 100px; }
  }
</style>
