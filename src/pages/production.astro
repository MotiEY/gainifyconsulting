---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';

const SITE_URL = 'https://motisadot.com';
const phoneDigits = SITE.phone.replace('+', '');
const waMessage = 'היי מוטי, הגעתי מהדף לעסקים יצרניים ואשמח לשיחת היכרות';
const waUrl = `https://wa.me/${phoneDigits}?text=${encodeURIComponent(waMessage)}`;

const title = 'מוטי שדות · ייעוץ עסקי לעסקים יצרניים';
const description = 'ליווי עסקי לבעלי עסקים יצרניים שרוצים לצמוח: רווחיות ותכנון, תפעול, מלאי ורכש, וטכנולוגיה ו־AI.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={`${SITE_URL}/production/`}
  ogImage={`${SITE_URL}/og/landing-production-v2.jpg`}
  ogImageAlt="מוטי שדות. ליווי עסקי שמתחיל ברווחיות, לבעלי עסקים יצרניים"
  noindex
  minimal
  noHeader
  asyncFonts
>
<div class="pr">
<section style="max-width: 1180px; margin: 0 auto; padding: 56px 24px 72px; display: flex; flex-wrap: wrap; align-items: center; gap: 48px">
<div style="flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 22px">
<p style="margin: 0; font-size: 17px; font-weight: 500; color: var(--pr-blue)">מוטי שדות · לבעלי עסקים יצרניים שרוצים לצמוח</p>
<h1 style="margin: 0; font-size: clamp(32px, 4.2vw, 50px); line-height: 1.2; font-weight: 700">ליווי עסקי שמתחיל ברווחיות וממשיך לתפעול, למלאי ולמכירות.</h1>
<p style="margin: 0; font-size: 20px; color: var(--pr-text); max-width: 560px">אני בודק מה משפיע על הרווחיות של העסק, ועובד עם בעל העסק והצוות עד שהשינוי קורה בפועל.</p>
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 8px">
<a class="pr-btn" href={waUrl} target="_blank" rel="noopener noreferrer" data-ga-page="production" style="display: inline-flex; align-items: center; min-height: 46px; padding: 0 24px; border-radius: 999px; background: var(--pr-blue); color: var(--pr-on-blue); font-size: 17px; font-weight: 600; text-decoration: none">בואו נכיר בוואטסאפ</a>
<span style="font-size: 17px; color: var(--pr-text)">או להתקשר: <a class="pr-tel" href="tel:+972525523021" data-ga-page="production" style="color: var(--pr-blue); font-weight: 600; text-decoration: none">052-552-3021</a></span>
</div>
</div>
<div style="flex: 1 1 340px; min-width: 0; max-width: 440px; margin: 0 auto">
<img src="/production/moti.webp" width="762" height="953" decoding="async" alt="מוטי שדות" style="display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center top; border-radius: 24px">
</div>
</section>

<section style="max-width: 1180px; margin: 0 auto; padding: 24px 24px 80px">
<h2 style="margin: 0 0 32px; font-size: 32px; font-weight: 700">במה אוכל לעזור לעסק שלך</h2>
<div style="display: flex; flex-wrap: wrap; gap: 24px">
<div style="flex: 1 1 280px; min-width: 0; border-top: 3px solid var(--pr-blue); padding: 22px 0 0; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 22px; font-weight: 700">רווחיות ותכנון</h3>
<p style="margin: 0; font-size: 18px; color: var(--pr-text)">לדעת אילו מוצרים באמת מרוויחים, לתמחר נכון, ולתכנן את התזרים לקראת השקעות והרחבת הפעילות.</p>
</div>
<div style="flex: 1 1 280px; min-width: 0; border-top: 3px solid var(--pr-blue); padding: 22px 0 0; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 22px; font-weight: 700">תפעול, מלאי ורכש</h3>
<p style="margin: 0; font-size: 18px; color: var(--pr-text)">לעמוד ביותר הזמנות: תהליכי עבודה מסודרים, מלאי לפי הביקוש והתזרים, ותיאום בין המכירות, התפעול והרכש.</p>
</div>
<div style="flex: 1 1 280px; min-width: 0; border-top: 3px solid var(--pr-blue); padding: 22px 0 0; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 22px; font-weight: 700">טכנולוגיה ו־AI</h3>
<p style="margin: 0; font-size: 18px; color: var(--pr-text)">לשפר את חוויית הלקוח ולהגדיל מכירות עם הצוות הקיים, בעזרת כלים למענה, מעקב ואוטומציה.</p>
</div>
</div>
</section>

<section style="max-width: 1180px; margin: 0 auto; padding: 0 24px 88px">
<h2 style="margin: 0 0 20px; font-size: 32px; font-weight: 700">איך אני עובד</h2>
<div style="max-width: 800px; display: flex; flex-direction: column; gap: 14px">
<p style="margin: 0; font-size: 20px">אני מתחיל מהתמחור, מהעלויות ומהתזרים, כי שם רואים איך העסק באמת עובד. אבל מה שמשפיע עליהם נמצא לרוב בהתנהלות היומיומית: ברכש, במלאי, בתפעול ובמכירות.</p>
<p style="margin: 0; font-size: 20px; color: var(--pr-text)">לכן אני בוחן את העסק כולו, ומברר מה באמת משפיע על התוצאות. משם בונים יחד תוכנית, מגדירים מי אחראי על מה ואיך מודדים, ועובדים על היישום עם הצוות.</p>
</div>
</section>

<section style="max-width: 1180px; margin: 0 auto; padding: 0 24px 56px">
<p style="margin: 0 0 8px; font-size: 15px; font-weight: 700; color: var(--pr-blue)">דוגמה מהעבודה</p>
<h2 style="margin: 0 0 18px; font-size: 32px; font-weight: 700">היו לקוחות שרצו לקנות. הייצור לא עמד בקצב.</h2>
<div style="max-width: 800px; display: flex; flex-direction: column; gap: 14px">
<p style="margin: 0; font-size: 20px; color: var(--pr-text)">אצל דור, יצרן עם כ־10 עובדי ייצור, היו יותר הזמנות ממה שהמפעל הספיק לייצר.</p>
<p style="margin: 0; font-size: 20px; color: var(--pr-text)">האפשרות להוסיף מפעל נוסף כבר הייתה על השולחן. חיברנו אותה לבעיה ובדקנו אותה לעומק: כמה ייצור היא מוסיפה, מה היא עולה, ואיך היא עומדת מול החלופה. העלות התבררה כנמוכה, וההחלטה הפכה לברורה. העסקה יצאה לפועל: קו מוצרים שלם עבר למפעל הנוסף, והמפעל הקיים התפנה לשאר המוצרים. היום אנחנו עובדים על הגדלת המכירות, כדי לנצל את הייצור שנוסף.</p>
</div>
</section>


<section style="max-width: 1180px; margin: 0 auto; padding: 40px 24px 80px">
<div style="max-width: 800px; display: flex; flex-direction: column; gap: 14px">
<h2 style="margin: 0 0 6px; font-size: 32px; font-weight: 700">נעים להכיר, אני מוטי שדות</h2>
<p style="margin: 0; font-size: 20px; color: var(--pr-text)">במשך 26 שנים הייתי מנהל בכיר בחברה גלובלית. ניהלתי אנשים, תקציבים ורווח והפסד, והקמתי פעילויות חדשות מאפס. משם יצאתי לעצמאות, כדי לעבוד ישירות עם בעלי עסקים.</p>
<p style="margin: 0; font-size: 20px; color: var(--pr-text)">מה שאני מביא: ראייה של כל העסק, מהדוחות ועד העבודה היומיומית, והיכולת לחבר ביניהם. אני יודע לקרוא מספרים, להבין תהליכים ולהשתמש בטכנולוגיה כדי שהדברים יעבדו בפועל.</p>
<p style="margin: 0; font-size: 20px; color: var(--pr-text)">אני עובד לצד בעל העסק והצוות, בגובה העיניים, ומתאים את העבודה לגודל העסק ולמשאבים שלו. ההחלטות נשארות של בעל העסק. התפקיד שלי לדאוג שהן מבוססות ושהן מגיעות לביצוע.</p>
</div>
</section>
<section style="background: var(--pr-band); padding: 72px 24px">
<figure style="max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 22px">
<blockquote style="margin: 0; font-size: clamp(26px, 3vw, 36px); line-height: 1.35; font-weight: 700; color: var(--pr-ink)">״ייעוץ טוב מבעל מקצוע שאתה סומך עליו עוזר לך מאוד להגיע ליעדים מהר יותר.״</blockquote>
<figcaption style="font-size: 18px; color: var(--pr-blue-d)"><strong>דור</strong> · בעל עסק יצרני</figcaption>
</figure>
</section>

<section style="max-width: 1180px; margin: 0 auto; padding: 88px 24px 88px">
<div>
<h2 style="margin: 0 0 32px; font-size: 32px; font-weight: 700">איך מתחילים</h2>
<div style="display: flex; flex-wrap: wrap; gap: 24px">
<div style="flex: 1 1 260px; min-width: 0; display: flex; gap: 16px; align-items: flex-start">
<span style="flex: 0 0 36px; font-size: 34px; line-height: 1; font-weight: 700; color: var(--pr-blue)">1</span>
<div><h3 style="margin: 0 0 6px; font-size: 20px; font-weight: 700">שיחת היכרות, ללא עלות</h3><p style="margin: 0; font-size: 18px; color: var(--pr-text)">נכיר את העסק ואת התוכניות שלך, ונבדוק את ההתאמה לליווי.</p></div>
</div>
<div style="flex: 1 1 260px; min-width: 0; display: flex; gap: 16px; align-items: flex-start">
<span style="flex: 0 0 36px; font-size: 34px; line-height: 1; font-weight: 700; color: var(--pr-blue)">2</span>
<div><h3 style="margin: 0 0 6px; font-size: 20px; font-weight: 700">אבחון</h3><p style="margin: 0; font-size: 18px; color: var(--pr-text)">מסתכלים על העסק כולו, בוחרים תחום אחד וקובעים מטרות ומדדים.</p></div>
</div>
<div style="flex: 1 1 260px; min-width: 0; display: flex; gap: 16px; align-items: flex-start">
<span style="flex: 0 0 36px; font-size: 34px; line-height: 1; font-weight: 700; color: var(--pr-blue)">3</span>
<div><h3 style="margin: 0 0 6px; font-size: 20px; font-weight: 700">ארבע פגישות עבודה</h3><p style="margin: 0; font-size: 18px; color: var(--pr-text)">לאורך 4 עד 5 שבועות. מגדירים צעדים, עובדים על היישום ובודקים התקדמות מול המטרות והמדדים שנקבעו בהתחלה.</p></div>
</div>
</div>
<p style="margin: 20px 0 0; padding-right: 52px; font-size: 18px; font-weight: 500; color: var(--pr-blue-d)">האבחון וארבע פגישות העבודה הם חבילת ליווי אחת, בתשלום. 10&nbsp;עסקים ראשונים מקבלים אותה במחיר מוזל.</p>
</div>
</section>

<section style="background: var(--pr-band); padding: 80px 24px">
<div style="max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center">
<h2 style="margin: 0; font-size: clamp(30px, 3.6vw, 42px); font-weight: 700; color: var(--pr-ink)">מה חשוב לך לקדם בעסק?</h2>
<p style="margin: 0; font-size: 20px; color: var(--pr-text)">נכיר את העסק ואת התוכניות שלך, ונבדוק איך אפשר לעבוד יחד.</p>
<a class="pr-btn" href={waUrl} target="_blank" rel="noopener noreferrer" data-ga-page="production" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 26px; margin-top: 6px; border-radius: 999px; background: var(--pr-blue); color: var(--pr-on-blue); font-size: 17px; font-weight: 600; text-decoration: none">בואו נכיר בוואטסאפ</a>
<span style="font-size: 17px; color: var(--pr-text)">או להתקשר: <a class="pr-tel" href="tel:+972525523021" data-ga-page="production" style="color: var(--pr-blue); font-weight: 600; text-decoration: none">052-552-3021</a></span>
</div>
</section>

<div class="wa-bar" style="position: fixed; left: 0; right: 0; bottom: 0; padding: 8px 12px 8px 66px; background: var(--pr-bar); border-top: 1px solid var(--pr-line); justify-content: center; z-index: 10">
<a class="pr-btn" href={waUrl} target="_blank" rel="noopener noreferrer" data-ga-page="production" style="display: flex; align-items: center; justify-content: center; width: 100%; max-width: 420px; min-height: 46px; border-radius: 999px; background: var(--pr-blue); color: var(--pr-on-blue); font-size: 16px; font-weight: 600; text-decoration: none">בואו נכיר בוואטסאפ</a>
</div>
</div>
</BaseLayout>

<script>
  // the fixed bar is only shown when none of the page's whatsapp buttons is on screen
  const bar = document.querySelector('.wa-bar');
  const buttons = document.querySelectorAll('.pr-btn');
  if (bar && buttons.length && 'IntersectionObserver' in window) {
    const visible = new Set();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
        bar.classList.toggle('is-hidden', visible.size > 0);
      },
      { threshold: 0.6, rootMargin: '0px 0px -70px 0px' }
    );
    buttons.forEach((b) => io.observe(b));
  }
</script>

<style>
.pr{
  --pr-bg:#FBFAF7; --pr-ink:#13233A; --pr-text:#36414D; --pr-blue:#1F5FAE; --pr-blue-h:#174C8C; --pr-blue-d:#1A4E8F;
  --pr-band:#EEF2F6; --pr-line:#E3E8EC; --pr-on-blue:#FFFFFF; --pr-bar:rgba(251,250,247,0.96);
  direction:rtl; font-family:'Assistant',system-ui,sans-serif; color:var(--pr-ink); background:var(--pr-bg); line-height:1.65;
}
html.a11y-high-contrast .pr{
  --pr-bg:#0a0a0a; --pr-ink:#f5f5e8; --pr-text:#ccc4b0; --pr-blue:#f0c040; --pr-blue-h:#ffd966; --pr-blue-d:#f0c040;
  --pr-band:#161616; --pr-line:rgba(245,245,232,.28); --pr-on-blue:#0a0a0a; --pr-bar:rgba(10,10,10,.96);
}
.pr h1,.pr h2,.pr h3,.pr blockquote{text-wrap:balance}
.pr p{text-wrap:pretty}
.pr a:not(.pr-btn){color:var(--pr-blue)}
.pr a:not(.pr-btn):hover{color:var(--pr-blue-h)}
.pr-btn:hover{background:var(--pr-blue-h) !important}
.pr a:focus-visible{outline:2px solid var(--pr-blue);outline-offset:3px;border-radius:8px}
.pr-tel{white-space:nowrap;display:inline-block;padding:10px 4px;margin:-10px -4px}
.wa-bar{display:none}
@media (max-width:720px){
  .wa-bar{display:flex;transition:transform .25s ease,opacity .25s ease,visibility 0s linear 0s}
  /* while a whatsapp button of the page is on screen the bar steps aside (no double button); without JS it stays */
  .wa-bar.is-hidden{transform:translateY(100%);opacity:0;visibility:hidden;transition:transform .25s ease,opacity .25s ease,visibility 0s linear .25s}
  /* the fixed bar must not hide the end of the page */
  :global(footer.site-footer.site-footer){padding-bottom:84px}
  /* accessibility button: always in the bottom-left corner, in the same row as the bar */
  :global(body #a11y-trigger){width:44px;height:44px;left:10px;bottom:9px}
  :global(body #a11y-panel){bottom:70px}
}
@media (prefers-reduced-motion:reduce){.wa-bar,.wa-bar.is-hidden{transition:none}}
</style>
