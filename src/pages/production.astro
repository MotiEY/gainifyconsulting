---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';

const SITE_URL = 'https://motisadot.com';
const phoneDigits = SITE.phone.replace('+', '');
const waMessage = "היי מוטי, הגעתי מהדף לעסקים יצרניים ואשמח לשיחת היכרות";
const waUrl = `https://wa.me/${phoneDigits}?text=${encodeURIComponent(waMessage)}`;

const title = 'ליווי עסקי לעסקים יצרניים | מוטי שדות';
const description = 'מייצרים, מוכרים, עובדים קשה. ובסוף החודש, איפה הכסף? ליווי עסקי לעסקים יצרניים, דרך המספרים.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={`${SITE_URL}/production/`}
  ogImage={`${SITE_URL}/og/landing-production.jpg`}
  ogImageAlt="מוטי שדות במשרד. ליווי עסקי לעסקים יצרניים"
  headerCta={{ href: waUrl, label: 'לשיחת היכרות', gaPage: 'production' }}
  noindex
  minimal
  asyncFonts
>
<div class="pr">
<section class="pad-hero" style="max-width: 1120px; margin: 0 auto; padding: 88px 24px 96px">
<div class="hero">
<div style="min-width: 0">
<img class="avatar-m" src="/production/moti-illustration.webp" width="360" height="349" decoding="async" alt="מוטי שדות" style="width: 88px; height: 88px; object-fit: cover; object-position: 50% 22%; border-radius: 50%; background: var(--pr-card); border: 1px solid var(--line); margin-bottom: 18px">
<p style="margin: 0; font-size: 14px; letter-spacing: .12em; font-weight: 600; color: var(--pr-bronze)">ליווי עסקי לעסקים יצרניים</p>
<h1 class="h1" style="margin: 18px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 900; font-size: 58px; line-height: 1.12; color: var(--pr-ink)">מייצרים. מוכרים. <span class="nw">עובדים קשה.</span><br><span style="color: var(--pr-bronze)">ובסוף החודש, <span class="nw">איפה הכסף?</span></span></h1>
<p style="margin: 22px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 500; font-size: 26px; color: var(--pr-ink)">בוא נבין יחד, דרך המספרים.</p>
<p style="margin: 18px 0 0; font-size: 19px; color: var(--pr-mid); max-width: 34em">אני מלווה בעלי עסקים יצרניים. מתחילים מהמספרים: כמה העסק באמת מרוויח, על איזה מוצר, ואיפה הכסף נתקע.</p>
<div class="actions" style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px">
<a class="btn btn-dark" href={waUrl} data-ga-page="production" target="_blank" rel="noopener">שלח לי הודעה בוואטסאפ</a>
<a class="btn btn-ghost" href="https://cal.com/moti-qkwojg/15min" data-ga-page="production" target="_blank" rel="noopener">לקביעת שיחת היכרות</a>
</div>
<p style="margin: 16px 0 0; font-size: 15px; color: var(--pr-mid2)">רבע שעה כדי להבין מה מטריד אותך בעסק, והאם הליווי מתאים לך.</p>
<p style="margin: 14px 0 0; display: inline-block; font-size: 15px; font-weight: 600; color: var(--pr-bronze-d); background: rgba(194,168,120,.22); border-radius: 999px; padding: 6px 16px">10 עסקים ראשונים מקבלים מחיר מוזל</p>
</div>
<div class="hero-photo" style="min-width: 0">
<img class="ph" src="/production/moti-office.webp" width="900" height="1125" loading="lazy" decoding="async" alt="מוטי שדות במשרד" style="display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; border-radius: 22px; box-shadow: 0 18px 40px rgba(31,26,19,.12)">
</div>
</div>
</section>

<section style="background: var(--pr-alt); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line)">
<div class="pad" style="max-width: 1120px; margin: 0 auto; padding: 96px 24px">
<div class="cash">
<div style="min-width: 0">
<p style="margin: 0; font-size: 14px; letter-spacing: .12em; font-weight: 600; color: var(--pr-bronze)">הסיפור שהמספרים מספרים</p>
<h2 class="h2" style="margin: 14px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 900; font-size: 40px; line-height: 1.2; color: var(--pr-ink)">כמה מהיתרה בבנק באמת שלך?</h2>
<p style="margin: 20px 0 0; color: var(--pr-mid)">באפליקציה של הבנק כתוב 240 אלף. אבל רוב הכסף הזה כבר בדרך החוצה: מע"מ, משכורות, צ'קים שכבר נתת לספקים, וחומר גלם להזמנות שלקוחות כבר שילמו עליהן.</p>
<p style="margin: 14px 0 0; color: var(--pr-body); font-weight: 600">ואת ההחלטות בעסק כדאי לקבל לפי המספר השני.</p>
</div>
<div style="min-width: 0; background: var(--pr-card); border: 1px solid var(--line); border-radius: 22px; padding: 32px">
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px">
<span style="font-size: 16px; color: var(--pr-mid)">היתרה בבנק</span>
<span style="font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 32px; color: var(--pr-ink); white-space: nowrap">240,000 ₪</span>
</div>
<div class="seg-row" style="margin-top: 18px" aria-hidden="true">
<div style="flex: 0 0 15.8%; background: #D8CDB8"></div>
<div style="flex: 0 0 38.3%; background: #C2B095"></div>
<div style="flex: 0 0 21.7%; background: #A8947A"></div>
<div style="flex: 0 0 14.2%; background: #8A7660"></div>
<div style="flex: 0 0 5.0%; background: #6B5A47"></div>
<div style="flex: 1 1 0; background: var(--pr-ink)"></div>
</div>
<div style="display: flex; flex-direction: column; gap: 10px; margin-top: 22px; font-size: 16px">
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px"><span style="display: flex; align-items: baseline; gap: 10px"><span style="flex: none; width: 12px; height: 12px; border-radius: 3px; background: #D8CDB8"></span>מע"מ לתשלום</span><span style="color: var(--pr-mid); white-space: nowrap">38,000 ₪</span></div>
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px"><span style="display: flex; align-items: baseline; gap: 10px"><span style="flex: none; width: 12px; height: 12px; border-radius: 3px; background: #C2B095"></span>משכורות והפרשות</span><span style="color: var(--pr-mid); white-space: nowrap">92,000 ₪</span></div>
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px"><span style="display: flex; align-items: baseline; gap: 10px"><span style="flex: none; width: 12px; height: 12px; border-radius: 3px; background: #A8947A"></span>צ'קים דחויים לספקים</span><span style="color: var(--pr-mid); white-space: nowrap">52,000 ₪</span></div>
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px"><span style="display: flex; align-items: baseline; gap: 10px"><span style="flex: none; width: 12px; height: 12px; border-radius: 3px; background: #8A7660"></span>חומר גלם להזמנות שכבר שולמו</span><span style="color: var(--pr-mid); white-space: nowrap">34,000 ₪</span></div>
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px"><span style="display: flex; align-items: baseline; gap: 10px"><span style="flex: none; width: 12px; height: 12px; border-radius: 3px; background: #6B5A47"></span>מקדמות מס והחזר הלוואה</span><span style="color: var(--pr-mid); white-space: nowrap">12,000 ₪</span></div>
<div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-top: 12px; border-top: 1px solid var(--line-mid); font-weight: 700; color: var(--pr-ink)"><span style="display: flex; align-items: baseline; gap: 10px"><span style="flex: none; width: 12px; height: 12px; border-radius: 3px; background: var(--pr-ink)"></span>נשאר אחרי ההתחייבויות</span><span style="font-family: 'Frank Ruhl Libre', Georgia, serif; font-size: 22px; white-space: nowrap">12,000 ₪</span></div>
</div>
<p style="margin: 18px 0 0; font-size: 13px; color: var(--pr-mid2)">דוגמה להמחשה בלבד, לא נתונים של לקוח. מה שנשאר הוא עדיין לא רווח, אבל עליו אפשר לתכנן.</p>
</div>
</div>
</div>
</section>

<section class="pad narrow" style="max-width: 1120px; margin: 0 auto; padding: 96px 24px">
<p style="margin: 0; font-size: 14px; letter-spacing: .12em; font-weight: 600; color: var(--pr-bronze)">מכיר את זה?</p>
<h2 class="h2" style="margin: 14px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 900; font-size: 40px; line-height: 1.2; color: var(--pr-ink)">העסק עובד חזק. השאלה היא מה נשאר בסוף.</h2>
<ul style="list-style: none; margin: 32px 0 0; padding: 0; border-top: 1px solid var(--line-mid)">
<li style="padding: 20px 0; border-bottom: 1px solid var(--line-mid); display: flex; gap: 14px; align-items: baseline"><span aria-hidden="true" style="flex: none; width: 8px; height: 8px; border-radius: 50%; background: #C2A878; transform: translateY(-2px)"></span>ההזמנות עולות, ובבנק לא מרגישים את זה.</li>
<li style="padding: 20px 0; border-bottom: 1px solid var(--line-mid); display: flex; gap: 14px; align-items: baseline"><span aria-hidden="true" style="flex: none; width: 8px; height: 8px; border-radius: 50%; background: #C2A878; transform: translateY(-2px)"></span>לא ברור על איזה מוצר מרוויחים, ועל איזה רק עובדים.</li>
<li style="padding: 20px 0; border-bottom: 1px solid var(--line-mid); display: flex; gap: 14px; align-items: baseline"><span aria-hidden="true" style="flex: none; width: 8px; height: 8px; border-radius: 50%; background: #C2A878; transform: translateY(-2px)"></span>המלאי במחסן גדל, והכסף תקוע שם.</li>
<li style="padding: 20px 0; border-bottom: 1px solid var(--line-mid); display: flex; gap: 14px; align-items: baseline"><span aria-hidden="true" style="flex: none; width: 8px; height: 8px; border-radius: 50%; background: #C2A878; transform: translateY(-2px)"></span>המבצע האחרון הביא מחזור יפה. כמה מזה נשאר רווח?</li>
<li style="padding: 20px 0; border-bottom: 1px solid var(--line-mid); display: flex; gap: 14px; align-items: baseline"><span aria-hidden="true" style="flex: none; width: 8px; height: 8px; border-radius: 50%; background: #C2A878; transform: translateY(-2px)"></span>רוצים לגייס עוד עובד, ולא בטוחים שהמספרים מצדיקים את זה.</li>
</ul>
<p style="margin: 24px 0 0; color: var(--pr-mid)">אלה לא שאלות קשות. הן שאלות שקל לדחות כשהעסק עסוק.</p>
</section>

<section style="background: #1F1A13">
<div class="pad narrow" style="max-width: 1120px; margin: 0 auto; padding: 96px 24px">
<p style="margin: 0; font-size: 14px; letter-spacing: .12em; font-weight: 600; color: #C2A878">דור, על העבודה יחד</p>
<blockquote style="margin: 20px 0 0; padding: 0">
<p class="q" style="margin: 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 500; font-size: 32px; line-height: 1.45; color: #F6EFE1">"ייעוץ טוב מבעל מקצוע שאתה סומך עליו עוזר לך מאוד להגיע ליעדים מהר יותר."</p>
<footer style="margin-top: 22px; font-size: 16px; color: #BCB0A0">דור, אן די גארדן קאבר־אפ · יצרן ריהוט וכיסויים לגינה</footer>
</blockquote>
</div>
</section>

<section style="background: var(--pr-alt); border-bottom: 1px solid var(--line)">
<div class="pad" style="max-width: 1120px; margin: 0 auto; padding: 96px 24px">
<p style="margin: 0; font-size: 14px; letter-spacing: .12em; font-weight: 600; color: var(--pr-bronze)">מהשטח</p>
<h2 class="h2" style="margin: 14px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 900; font-size: 40px; line-height: 1.2; color: var(--pr-ink)">כשהייצור מגביל את ההכנסות.</h2>
<p style="margin: 14px 0 0; font-size: 19px; color: var(--pr-mid); max-width: 40em">דור, יצרן ריהוט וכיסויים לגינה.</p>
<div class="cols3" style="margin-top: 32px">
<div style="background: var(--pr-card); border: 1px solid var(--line); border-radius: 20px; padding: 28px; min-width: 0">
<p style="margin: 0; font-size: 14px; font-weight: 600; letter-spacing: .08em; color: var(--pr-bronze)">איפה זה התחיל</p>
<h3 style="margin: 10px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 22px; line-height: 1.3; color: var(--pr-ink)">היה ביקוש. הייצור לא הספיק.</h3>
<p style="margin: 10px 0 0; font-size: 17px; color: var(--pr-mid)">העסק לא הצליח לקבל את כל ההזמנות, וזה הגביל את ההכנסות. דור עצמו היה חלק מהידיים העובדות: גזרן, שכל העובדים פונים אליו בשאלות.</p>
</div>
<div style="background: var(--pr-card); border: 1px solid var(--line); border-radius: 20px; padding: 28px; min-width: 0">
<p style="margin: 0; font-size: 14px; font-weight: 600; letter-spacing: .08em; color: var(--pr-bronze)">מה עשינו</p>
<h3 style="margin: 10px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 22px; line-height: 1.3; color: var(--pr-ink)">דור יצא מהשוטף והתחיל לנהל</h3>
<p style="margin: 10px 0 0; font-size: 17px; color: var(--pr-mid)">בנינו יחד את המעבר מעבודה בייצור לניהול העסק. דור החליט להרחיב את הייצור ורכש מפעל נוסף.</p>
</div>
<div style="background: var(--pr-card); border: 1px solid var(--line); border-radius: 20px; padding: 28px; min-width: 0">
<p style="margin: 0; font-size: 14px; font-weight: 600; letter-spacing: .08em; color: var(--pr-bronze)">מה השתנה</p>
<h3 style="margin: 10px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 22px; line-height: 1.3; color: var(--pr-ink)">ההכנסות עולות</h3>
<p style="margin: 10px 0 0; font-size: 17px; color: var(--pr-mid)">הייצור עובד ביעילות רבה יותר, ויעדי ההכנסות לשנה הבאה כבר גבוהים יותר. עכשיו עובדים על המכירות: יעד לכל מוכר, ואיך עוזרים לו להגיע אליו.</p>
</div>
</div>
</div>
</section>

<section style="background: var(--pr-alt2)">
<div class="pad" style="max-width: 1120px; margin: 0 auto; padding: 96px 24px">
<p style="margin: 0; font-size: 14px; letter-spacing: .12em; font-weight: 600; color: var(--pr-bronze)">על מה עובדים</p>
<h2 class="h2" style="margin: 14px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 900; font-size: 40px; line-height: 1.2; color: var(--pr-ink)">שלושה תחומים. מתחילים מהכסף.</h2>
<p style="margin: 14px 0 0; font-size: 19px; color: var(--pr-mid); max-width: 40em">מלאי, רכש ו־AI הם הדרכים לשפר את מה שהמספרים מראים.</p>
<div class="cols3" style="margin-top: 36px">
<div style="background: var(--pr-alt); border-radius: 20px; padding: 30px; min-width: 0">
<p style="margin: 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 18px; color: var(--pr-bronze)">01</p>
<h3 style="margin: 10px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 24px; color: var(--pr-ink)">כסף</h3>
<p style="margin: 12px 0 0; font-size: 17px; color: var(--pr-mid)">רווחיות לפי מוצר, תזרים מזומנים, תמחור ותחזית. לדעת איפה הכסף, ואיפה הוא נתקע.</p>
</div>
<div style="background: var(--pr-alt); border-radius: 20px; padding: 30px; min-width: 0">
<p style="margin: 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 18px; color: var(--pr-bronze)">02</p>
<h3 style="margin: 10px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 24px; color: var(--pr-ink)">מלאי ורכש</h3>
<p style="margin: 12px 0 0; font-size: 17px; color: var(--pr-mid)">מה שוכב במחסן, מה קונים ומתי, ואיך זה משפיע על התזרים.</p>
</div>
<div style="background: var(--pr-alt); border-radius: 20px; padding: 30px; min-width: 0">
<p style="margin: 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 18px; color: var(--pr-bronze)">03</p>
<h3 style="margin: 10px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 24px; color: var(--pr-ink)">AI בעבודה היומיומית</h3>
<p style="margin: 12px 0 0; font-size: 17px; color: var(--pr-mid)">כלים שמשפרים את חוויית הלקוח ומגדילים מכירות, בלי להוסיף עובדים. מתחילים ממה שהעסק צריך.</p>
</div>
</div>
</div>
</section>

<section class="pad narrow" style="max-width: 1120px; margin: 0 auto; padding: 96px 24px">
<p style="margin: 0; font-size: 14px; letter-spacing: .12em; font-weight: 600; color: var(--pr-bronze)">איך זה עובד</p>
<h2 class="h2" style="margin: 14px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 900; font-size: 40px; line-height: 1.2; color: var(--pr-ink)">צעד אחר צעד.</h2>
<ol style="list-style: none; margin: 34px 0 0; padding: 0; display: flex; flex-direction: column; gap: 28px">
<li style="display: flex; gap: 20px; align-items: flex-start">
<span aria-hidden="true" style="flex: none; width: 46px; height: 46px; border-radius: 50%; background: var(--pr-btn-bg); color: var(--pr-btn-ink); display: flex; align-items: center; justify-content: center; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 20px">1</span>
<div><h3 style="margin: 4px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 23px; color: var(--pr-ink)">שיחת היכרות <span style="font-family: Assistant, Arial, sans-serif; font-weight: 600; font-size: 14px; color: var(--pr-bronze-d); background: var(--bronze-l); border-radius: 999px; padding: 3px 12px; margin-inline-start: 8px; display: inline-block; white-space: nowrap; vertical-align: middle">ללא עלות</span></h3>
<p style="margin: 8px 0 0; color: var(--pr-mid)">רבע שעה כדי להבין מה מטריד אותך בעסק, לאן אתה רוצה להגיע, והאם הליווי מתאים לך.</p></div>
</li>
<li style="display: flex; gap: 20px; align-items: flex-start">
<span aria-hidden="true" style="flex: none; width: 46px; height: 46px; border-radius: 50%; background: var(--pr-btn-bg); color: var(--pr-btn-ink); display: flex; align-items: center; justify-content: center; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 20px">2</span>
<div><h3 style="margin: 4px 0 0; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 23px; color: var(--pr-ink)">אבחון <span style="font-family: Assistant, Arial, sans-serif; font-weight: 600; font-size: 14px; color: var(--pr-bronze-d); background: var(--bronze-l); border-radius: 999px; padding: 3px 12px; margin-inline-start: 8px; display: inline-block; white-space: nowrap; vertical-align: middle">תחילת הליווי</span></h3>
<p style="margin: 8px 0 0; color: var(--pr-mid)">אם מחליטים להמשיך: מסתכלים יחד על העסק כולו, דרך המספרים. איפה הכסף, כמה, ומה משפיע עליו.</p></div>
</li>
<li style="display: flex; gap: 20px; align-items: flex-start">
<span aria-hidden="true" style="flex: none; width: 46px; height: 46px; border-radius: 50%; background: var(--pr-btn-bg); color: var(--pr-btn-ink); display: flex; align-items: center; justify-content: center; font-family: 'Frank Ruhl Libre', Georgia, serif; font-weight: 700; font-size: 20px">3</span>
