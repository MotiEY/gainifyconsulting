---
import { SITE } from '../config';

const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="inner">
    <span class="footer-brand">{SITE.name} · {SITE.tagline}</span>
    <nav class="footer-links" aria-label="קישורי פוטר">
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></li>
        <li><a href="/nigshu">הצהרת נגישות</a></li>
        <li>
          <a
            href={SITE.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="הפרופיל של מוטי שדות ב-LinkedIn"
            class="footer-linkedin"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </li>
      </ul>
    </nav>
    <span class="footer-copy">© {year} Moti Sadot · מוטי שדות</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    border-top: 1px solid rgba(240, 234, 224, 0.05);
    padding: 36px 24px;
  }

  .site-footer .inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .footer-brand {
    font-family: 'Assistant', sans-serif;
    font-size: 13px;
    color: rgba(240, 234, 224, 0.6);
  }

  .footer-links ul {
    list-style: none;
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }

  .footer-links a {
    font-family: 'Assistant', sans-serif;
    font-size: 13px;
    color: rgba(240, 234, 224, 0.45);
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }
  @media (hover: hover) {
    .footer-links a:hover { color: rgba(240, 234, 224, 0.6); }
  }

  .footer-linkedin {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
  }

  .footer-copy {
    font-family: 'Assistant', sans-serif;
    font-size: 11px;
    color: rgba(240, 234, 224, 0.35);
  }

  @media (min-width: 768px) {
    .site-footer { padding: 40px 52px; }

    .site-footer .inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
    }

    .footer-links { gap: 32px; }
  }
</style>
