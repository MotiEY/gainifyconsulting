---
import { SITE } from '../config';
---
<section class="method-section" id="how">
  <div class="inner">

    <!-- Approach intro (merged from Approach.astro) -->
    <div class="method-top">
      <div class="method-left">
        <span class="tag reveal">איך אני עובד</span>
        <h2 class="method-heading reveal">מתחילים בלראות את העסק כמערכת אחת, לא כאוסף של בעיות נפרדות.</h2>
      </div>
      <div class="method-right">
        <p class="method-body reveal">אני עובד בגישת 7BRICKS, שמסתכלת על העסק כמערכת שלמה: שיווק, מכירות, תפעול, אנשים, פיננסים, ניהול ומנהיגות, וצמיחה. עבודה משותפת על המספרים, התהליכים והאנשים. לא עצות מהצד. חשיבה משותפת.</p>
        <p class="method-anchor reveal">כשהתמונה ברורה, נבנית דרך עבודה מעשית.</p>
      </div>
    </div>

    <!-- 7BRICKS grid -->
    <span id="method" aria-hidden="true"></span>
    <div class="bricks-label reveal">
      <span class="tag" style="margin-bottom:0">גישת 7BRICKS</span>
    </div>

    <div class="bricks-grid">
      <div class="brick reveal" data-n="01">
        <span class="brick-num">01</span>
        <span class="brick-name">שיווק</span>
        <p class="brick-desc">לקוחות מוצאים אותך, או שאתה רודף אחריהם?</p>
      </div>
      <div class="brick reveal" data-n="02">
        <span class="brick-num">02</span>
        <span class="brick-name">מכירות</span>
        <p class="brick-desc">יש לך תהליך שסוגר עסקאות, או שכל פגישה מרגישה אחרת?</p>
      </div>
      <div class="brick reveal" data-n="03">
        <span class="brick-num">03</span>
        <span class="brick-name">תפעול</span>
        <p class="brick-desc">העסק עובד כשאתה לא בחדר, או נעצר כשאתה יוצא?</p>
      </div>
      <div class="brick reveal" data-n="04">
        <span class="brick-num">04</span>
        <span class="brick-name">אנשים</span>
        <p class="brick-desc">הצוות לוקח אחריות על תוצאות, או ממלא תפקיד ותו לא?</p>
      </div>
      <div class="brick reveal" data-n="05">
        <span class="brick-num">05</span>
        <span class="brick-name">פיננסים</span>
        <p class="brick-desc">המספרים שלך מספרים את הסיפור האמיתי, או מרגיעים רגע ואז מתפוצצים?</p>
      </div>
      <div class="brick reveal" data-n="06">
        <span class="brick-num">06</span>
        <span class="brick-name">ניהול ומנהיגות</span>
        <p class="brick-desc">ההחלטות שלך מחזיקות בשטח, או שצריך לחזור עליהן שוב ושוב?</p>
      </div>
      <div class="brick reveal" data-n="07">
        <span class="brick-num">07</span>
        <span class="brick-name">צמיחה</span>
        <p class="brick-desc">יש לך מנוע צמיחה שעובד, או שאתה מסתמך על מה שהיה עד עכשיו?</p>
      </div>
    </div>

    <p class="bricks-summary-line reveal">התמונה המלאה מתבהרת כשמבינים איך חלקי העסק משפיעים אחד על השני.</p>

    <div class="bricks-cta reveal">
      <div class="bricks-cta-text">
        <p class="bricks-cta-q">אם חלק מזה מוכר לך,<br />שווה לבדוק מאיפה נכון להתחיל.</p>
        <p class="bricks-cta-sub">15 דקות שיחה. בלי עלות ובלי מחויבות. רק כדי להבין אם יש בסיס נכון להמשך.</p>
      </div>
      <a
        href={SITE.calUrl}
        class="bricks-cta-btn"
        target="_blank"
        rel="noopener noreferrer"
        data-cal-link={SITE.calLink}
      >
        בואו נדבר
      </a>
    </div>

  </div>
</section>

<style>
  /* mobile-first base */
  .method-section {
    border-top: 1px solid var(--line);
    padding: 72px 24px;
  }

  /* Approach top section */
  .method-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: start;
    margin-bottom: 64px;
  }

  .method-heading {
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 400;
    font-size: clamp(26px, 5vw, 38px);
    line-height: 1.15;
    color: var(--text-h);
    letter-spacing: -0.02em;
  }

  .method-right {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .method-body {
    font-family: 'Assistant', sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: var(--mid);
  }

  .method-anchor {
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 500;
    font-size: 21px;
    line-height: 1.45;
    color: var(--text-h);
    letter-spacing: -0.015em;
  }

  /* 7BRICKS label */
  .bricks-label {
    margin-bottom: 28px;
  }

  /* Grid */
  .bricks-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-block-start: 1px solid var(--line);
    border-inline-start: 1px solid var(--line);
  }

  .brick {
    border-inline-end: 1px solid var(--line);
    border-block-end: 1px solid var(--line);
    padding: 28px 20px;
    transition: background 0.25s;
    cursor: default;
    position: relative;
    overflow: hidden;
  }
  .brick::before {
    content: attr(data-n);
    position: absolute;
    inset-inline-end: -8px;
    bottom: -16px;
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 900;
    font-size: 88px;
    line-height: 1;
    color: rgba(122,100,69,0.06);
    letter-spacing: -0.04em;
    pointer-events: none;
    transition: color 0.35s;
  }
  @media (hover: hover) {
    .brick:hover { background: rgba(122,100,69,0.04); }
    .brick:hover::before { color: rgba(122,100,69,0.14); }
  }

  .brick-num {
    font-family: 'Assistant', sans-serif;
    font-size: 9px;
    letter-spacing: 2.5px;
    color: var(--bronze);
    opacity: 0.6;
    display: block;
    margin-bottom: 16px;
  }

  .brick-name {
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 400;
    font-size: 17px;
    color: var(--text-h);
    display: block;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .brick-desc {
    font-family: 'Assistant', sans-serif;
    font-size: 13px;
    line-height: 1.65;
    color: var(--mid);
  }

  .bricks-summary-line {
    text-align: center;
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 300;
    font-style: italic;
    font-size: clamp(19px, 4vw, 28px);
    color: var(--bronze);
    letter-spacing: -0.02em;
    line-height: 1.4;
    padding: 40px 24px;
    border-top: 1px solid rgba(122,100,69,0.2);
    border-bottom: 1px solid rgba(122,100,69,0.2);
  }

  /* CTA strip */
  .bricks-cta {
    margin-top: 0;
    background: rgba(122, 100, 69, 0.06);
    padding: 40px 24px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    align-items: flex-start;
  }

  .bricks-cta-q {
    font-family: 'Frank Ruhl Libre', serif;
    font-weight: 400;
    font-size: clamp(22px, 5vw, 34px);
    color: var(--text-h);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .bricks-cta-sub {
    font-family: 'Assistant', sans-serif;
    font-size: 15px;
    color: var(--mid);
    line-height: 1.7;
    margin-top: -12px;
  }

  .bricks-cta-btn {
    display: inline-flex;
    align-items: center;
    font-family: 'Assistant', sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--cream-dk);
    background: var(--dark);
    padding: 14px 32px;
    min-height: 44px;
    border-radius: var(--r-btn);
    transition: background 0.2s, transform 0.2s;
    white-space: nowrap;
  }
  .bricks-cta-btn:hover {
    background: var(--bronze);
    color: var(--cream);
    transform: translateY(-1px);
  }

  /* tablet */
  @media (min-width: 768px) {
    .method-section { padding: 90px 40px; }
    .brick { padding: 36px 26px; }
    .bricks-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 44px 40px;
      gap: 40px;
    }
    .bricks-cta-text { flex: 1; }
  }

  /* desktop */
  @media (min-width: 1280px) {
    .method-section { padding: 110px 52px 100px; }

    .method-top {
      grid-template-columns: 340px 1fr;
      gap: 100px;
      margin-bottom: 80px;
      align-items: start;
    }

    .method-heading {
      font-size: clamp(26px, 2.8vw, 38px);
      position: sticky;
      top: 80px;
    }

    .bricks-grid { grid-template-columns: repeat(7, 1fr); }
    .brick { padding: 28px 18px; }
    .brick-name  { font-size: 15px; }
    .brick-desc  { font-size: 12px; line-height: 1.65; }

    .bricks-summary-line {
      font-size: clamp(20px, 2vw, 28px);
      padding: 48px 0;
    }

    .bricks-cta { padding: 52px; }
    .bricks-cta-q { font-size: clamp(22px, 2.2vw, 34px); }
  }
</style>
